# Server-only. Do not use NEXT_PUBLIC_ prefixes for these values.
# Leave unset until an actual worker implements Docs/PIPELINE_API.md.
PIPELINE_API_URL=
# Shared operator boundary for the private pilot; at least 32 characters.
PIPELINE_CONTROL_TOKEN=
# Optional separate service-to-service bearer token, never sent to the browser.
PIPELINE_SERVICE_TOKEN=
# Optional: disable the framework's anonymous development/build telemetry.
NEXT_TELEMETRY_DISABLED=1

# Optional public asset path, not a secret. Leave empty until an approved clip is imported.
NEXT_PUBLIC_SCENE_MANIFEST=
