{
  "name": "perigee-mission-experience",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 5173",
    "build": "next build",
    "start": "node scripts/start-production.mjs",
    "preview": "npm run start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "frames": "node scripts/prepare-frames.mjs",
    "film:clean": "node scripts/render-clean-film.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "three": "^0.180.0",
    "zod": "^4.6.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.180.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "ffmpeg-static": "^5.3.0",
    "typescript": "^5.9.2",
    "vitest": "^5.0.0"
  }
